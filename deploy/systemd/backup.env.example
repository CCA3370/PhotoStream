# Copy to /etc/photostream/backup.env with mode 0600. Never commit real values.
# With POSTGRES_CONTAINER set, PostgreSQL tools run inside the container and this URL
# is used only for validated user/database names; no duplicate DB password is needed here.
DATABASE_URL=postgresql://photostream@postgres:5432/photostream
POSTGRES_CONTAINER=photostream-postgres-1
BACKUP_ENCRYPTION_PUBLIC_KEY_FILE=/etc/photostream/backup-public.pem
BACKUP_DIRECTORY=/var/backups/photostream

# Safe default: local encrypted backups only.
BACKUP_UPLOAD_DRIVER=none

# To enable offsite backup after explicit cloud authorization, set driver=aliyun.
# Use a private Beijing OSS bucket and a dedicated RAM credential restricted to
# oss:PutObject + oss:PutObjectAcl on this bucket/prefix. Uploads use Signature V4.
# BACKUP_UPLOAD_DRIVER=aliyun
# ALIYUN_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
# ALIYUN_OSS_BACKUP_BUCKET=replace-me
# ALIYUN_ACCESS_KEY_ID=replace-me
# ALIYUN_ACCESS_KEY_SECRET=replace-me
# BACKUP_OSS_PREFIX=photostream/database
