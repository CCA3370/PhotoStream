    "@photostream/contracts": "workspace:*",
    "@photostream/db": "workspace:*",
    "argon2": "0.45.1",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.1",
    "fastify-type-provider-zod": "7.0.0",
    "pg": "8.23.0",
    "zod": "4.4.3"
